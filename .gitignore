!**/.env.example
.env.local
.env.*.local
backend/.env
frontend/.env

# 含真实凭证的 compose（示例用 docker-compose.example.yml）
docker-compose.yml
docker-compose.override.yml

# 加密保险库与本地数据（含用户/创作 JSON、secrets.vault）
**/secrets.vault
*.vault
backend/data/

# 日志
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
