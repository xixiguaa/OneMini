# 服务
HOST=0.0.0.0
PORT=8000

# PostgreSQL 主库（复制为 .env 并填写真实密码，勿提交 .env）
# 应用在宿主机运行时：
DB_HOST=127.0.0.1
DB_PORT=5432
# 与 docker-compose 中 POSTGRES_USER / POSTGRES_DB 一致（示例值，勿用真实密码提交仓库）
DB_USER=admin
DB_PASSWORD=changeme
DB_NAME=myapp
# DATABASE_URL=postgresql+psycopg2://admin:changeme@127.0.0.1:5432/myapp
# 后端在 milvus-network 内：DB_HOST=postgres-server

# MinIO 对象存储（创作/画廊媒体）
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=onemini
MINIO_SECURE=false
# MINIO_ENDPOINT=minio-server:9000

# Milvus（Docker 默认映射）
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=onemini_knowledge
# 对话历史 / 长期语义记忆（Milvus + Attu 管理）
MILVUS_CHAT_COLLECTION=onemini_chat

# 嵌入模型（fastembed，本地 ONNX，无需 API Key）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# LLM（OpenAI 兼容，用于 RAG 回答生成）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini

# RAG（Milvus 向量知识库；与仓库 llm-wiki/ Markdown 知识库无关）
RAG_TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# 用户模型 API Key 保险库（生产务必设置强随机串；文件默认 data/secrets.vault）
SECRETS_MASTER_KEY=
SECRETS_FILE=data/secrets.vault

# JWT（生产务必更换）
JWT_SECRET=onemini-dev-jwt-change-in-production
