# 服务
HOST=0.0.0.0
PORT=8000

# Milvus（Docker 默认映射）
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=onemini_knowledge
# 对话历史（Milvus + Attu 管理）
MILVUS_CHAT_COLLECTION=onemini_chat

# 嵌入模型（fastembed，本地 ONNX，无需 API Key）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# LLM（OpenAI 兼容，用于 RAG 回答生成）
OPENAI_API_KEY=sk-f7725b23e5d143459f4a581b6385b97c
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini

# RAG（Milvus 向量知识库；与仓库 llm-wiki/  Markdown 知识库无关）
RAG_TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# 用户模型 API Key 保险库（生产务必设置强随机串；文件默认 data/secrets.vault）
SECRETS_MASTER_KEY=
SECRETS_FILE=data/secrets.vault
